# Per-country gateway credentials. Generate FRESH values for every line;
# never reuse a set between countries, never commit real values.
#   GATE_USER: "gw" + 3 random hex chars   (openssl rand -hex 3)
#   GATE_PASS: 32 random hex chars         (openssl rand -hex 16)
# scripts/add-country.sh generates these automatically. File mode must be 600.
GATE_USER=<GATE_USER>
GATE_PASS=<GATE_PASS>
